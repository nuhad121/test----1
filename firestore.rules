rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Bootstrapped Admin Verification & Database Admin Record Verification
    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == "a.mdnuhad534@gmail.com" && request.auth.token.email_verified == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email != null && exists(/databases/$(database)/documents/admin_emails/$(request.auth.token.email)))
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Entity Validators
    function isValidUserProfile(data) {
      return data.keys().hasAll(['id', 'email', 'role']) &&
        data.keys().hasOnly(['id', 'email', 'displayName', 'photoURL', 'phone', 'role', 'createdAt', 'updatedAt']) &&
        data.id is string && isValidId(data.id) &&
        data.email is string && data.email.size() <= 256 &&
        data.role is string && (data.role == 'customer' || data.role == 'admin') &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128)) &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1024)) &&
        (!('phone' in data) || (data.phone is string && data.phone.size() <= 32));
    }

    function isValidUserAddress(data) {
      return data.keys().hasAll(['id', 'userId', 'recipientName', 'street', 'city', 'postalCode', 'country']) &&
        data.keys().hasOnly(['id', 'userId', 'recipientName', 'street', 'apartment', 'city', 'state', 'postalCode', 'country', 'isDefault', 'createdAt']) &&
        data.id is string && isValidId(data.id) &&
        data.userId is string && isValidId(data.userId) &&
        data.recipientName is string && data.recipientName.size() <= 128 &&
        data.street is string && data.street.size() <= 256 &&
        data.city is string && data.city.size() <= 128 &&
        data.postalCode is string && data.postalCode.size() <= 32 &&
        data.country is string && data.country.size() <= 64;
    }

    function isValidWishlistItem(data) {
      return data.keys().hasAll(['id', 'userId', 'productId']) &&
        data.keys().hasOnly(['id', 'userId', 'productId', 'addedAt']) &&
        data.id is string && isValidId(data.id) &&
        data.userId is string && isValidId(data.userId) &&
        data.productId is string && isValidId(data.productId);
    }

   function isValidOrder(data) {
      return data.keys().hasAll(['id', 'userId', 'customerEmail', 'items', 'subtotal', 'shipping', 'tax', 'total', 'status', 'shippingAddress']) &&
        data.keys().hasOnly(['id', 'userId', 'customerEmail', 'customerName', 'items', 'subtotal', 'shipping', 'tax', 'total', 'status', 'shippingAddress', 'createdAt', 'updatedAt']) &&
        data.id is string && isValidId(data.id) &&
        data.userId is string && isValidId(data.userId) &&
        data.customerEmail is string && data.customerEmail.size() <= 256 &&
        data.total is number && data.total >= 0 &&
        data.status is string && (data.status in ['pending', 'processing', 'shipped', 'delivered', 'cancelled']);
    }

    function isValidProduct(data) {
      return data.keys().hasAll(['id', 'name', 'category', 'price', 'stock']) &&
        data.keys().hasOnly(['id', 'name', 'slug', 'category', 'price', 'description', 'details', 'images', 'sizes', 'stock', 'featured', 'createdAt', 'updatedAt']) &&
        data.id is string && isValidId(data.id) &&
        data.name is string && data.name.size() <= 256 &&
        data.category is string && data.category.size() <= 64 &&
        data.price is number && data.price >= 0 &&
        data.stock is number && data.stock >= 0;
    }

    function isValidAdminEmail(data) {
      return data.keys().hasAll(['email', 'addedAt']) &&
        data.keys().hasOnly(['email', 'addedBy', 'addedAt', 'notes']) &&
        data.email is string && data.email.size() <= 256 &&
        data.addedAt is string;
    }

    // User Profiles
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming()) && incoming().role == 'customer';
      allow update: if (
        isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming()) &&
        incoming().role == existing().role && incoming().id == existing().id &&
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'phone', 'updatedAt'])
      ) || isAdmin();
      allow delete: if isAdmin();

      // Shipping Addresses subcollection
      match /addresses/{addressId} {
        allow get, list: if isOwner(userId) || isAdmin();
        allow create, update: if (isOwner(userId) && isValidId(userId) && isValidId(addressId) && isValidUserAddress(incoming()) && incoming().userId == userId) || isAdmin();
        allow delete: if isOwner(userId) || isAdmin();
      }

      // Wishlist subcollection
      match /wishlist/{productId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(userId) && isValidId(productId) && isValidWishlistItem(incoming()) && incoming().userId == userId;
        allow delete: if isOwner(userId);
      }
    }

    // Orders Collection
    match /orders/{orderId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidId(orderId) && isValidOrder(incoming()) && incoming().userId == request.auth.uid && incoming().status == 'pending';
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Products Collection (Storefront catalog)
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() && isValidId(productId) && isValidProduct(incoming());
    }

    // System Admins
    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }

    // Authorized Admin Emails Registry
    match /admin_emails/{emailId} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin() && isValidAdminEmail(incoming());
    }
  }
}
